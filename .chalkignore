# .gitignore compatible file for ignoring files with chalk apply
# Chalk also respects .gitignore

# Ignore test files
tests

# Python artifacts
venv
*venv*
virtualenv
__pycache__
*.pyc
*.py~
.eggs
*.egg-info
dist
*.ipynb_checkpoints*

# Editor configuration
.vscode
.zed
.helix

# Intellij
*.iml
idea

# Git artifacts
.git
.github

# Backend routes/maintenance tools do not belong to the feature deployment.
# Person 3's api/agents, api/planner and api/evals remain available to Chalk.
api/main.py
api/auth.py
api/config.py
api/db.py
api/http_limits.py
api/integrations.py
api/models.py
api/services.py
api/storage.py
api/worker.py
api/workflows.py
scripts
supabase
docs/backend
Dockerfile
render.yaml
