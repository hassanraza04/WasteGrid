{
  "$defs": {
    "DemoProcessingStatus": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "last_heartbeat_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Heartbeat At"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "max_attempts": {
          "default": 4,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_new_reports": {
          "default": 2,
          "title": "Max New Reports",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "new_reports_admitted": {
          "default": 0,
          "title": "New Reports Admitted",
          "type": "integer"
        },
        "queue": {
          "$ref": "#/$defs/ProcessingQueue"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts At"
        },
        "status": {
          "default": "inactive",
          "enum": [
            "inactive",
            "active",
            "draining",
            "closed"
          ],
          "title": "Status",
          "type": "string"
        },
        "used_attempts": {
          "default": 0,
          "title": "Used Attempts",
          "type": "integer"
        },
        "worker_online": {
          "default": false,
          "title": "Worker Online",
          "type": "boolean"
        }
      },
      "title": "DemoProcessingStatus",
      "type": "object"
    },
    "OrganizerConfiguration": {
      "additionalProperties": false,
      "properties": {
        "messaging_pilot_enabled": {
          "title": "Messaging Pilot Enabled",
          "type": "boolean"
        },
        "organizer_routing_enabled": {
          "title": "Organizer Routing Enabled",
          "type": "boolean"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "road_service_configured": {
          "title": "Road Service Configured",
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "organizer_routing_enabled",
        "road_service_configured",
        "messaging_pilot_enabled"
      ],
      "title": "OrganizerConfiguration",
      "type": "object"
    },
    "OrganizerCounts": {
      "additionalProperties": false,
      "properties": {
        "available_crews": {
          "title": "Available Crews",
          "type": "integer"
        },
        "awaiting_assessment": {
          "title": "Awaiting Assessment",
          "type": "integer"
        },
        "blocked_jobs": {
          "title": "Blocked Jobs",
          "type": "integer"
        },
        "completed_24h": {
          "title": "Completed 24H",
          "type": "integer"
        },
        "high_priority_jobs": {
          "title": "High Priority Jobs",
          "type": "integer"
        },
        "in_progress_jobs": {
          "title": "In Progress Jobs",
          "type": "integer"
        },
        "needs_review": {
          "title": "Needs Review",
          "type": "integer"
        }
      },
      "required": [
        "needs_review",
        "high_priority_jobs",
        "in_progress_jobs",
        "available_crews",
        "blocked_jobs",
        "completed_24h",
        "awaiting_assessment"
      ],
      "title": "OrganizerCounts",
      "type": "object"
    },
    "ProcessingQueue": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "title": "Pending",
          "type": "integer"
        },
        "running": {
          "default": 0,
          "title": "Running",
          "type": "integer"
        },
        "succeeded": {
          "default": 0,
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "title": "ProcessingQueue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration": {
      "$ref": "#/$defs/OrganizerConfiguration"
    },
    "counts": {
      "$ref": "#/$defs/OrganizerCounts"
    },
    "include_illustrative": {
      "title": "Include Illustrative",
      "type": "boolean"
    },
    "processing": {
      "$ref": "#/$defs/DemoProcessingStatus"
    }
  },
  "required": [
    "counts",
    "include_illustrative",
    "configuration",
    "processing"
  ],
  "title": "OrganizerOverview",
  "type": "object"
}
