{
  "$defs": {
    "AuditEvent": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "created_at",
        "actor",
        "details"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "ClarificationRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "note",
        "location",
        "created_at"
      ],
      "title": "ClarificationRecord",
      "type": "object"
    },
    "Equipment": {
      "enum": [
        "gloves",
        "trash_bags",
        "broom",
        "shovel",
        "wheelbarrow",
        "pickup_truck"
      ],
      "title": "Equipment",
      "type": "string"
    },
    "EventView": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "created_at"
      ],
      "title": "EventView",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "unassigned",
        "assigned",
        "in_progress",
        "blocked",
        "completed",
        "recheck_requested"
      ],
      "title": "JobState",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "landmark": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Landmark"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Location",
      "type": "object"
    },
    "OrganizerReportView": {
      "additionalProperties": false,
      "description": "Organizer and trusted reasoning context, never a resident response.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Address"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/WasteAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assessment_status": {
          "default": "pending",
          "enum": [
            "pending",
            "assessed",
            "needs_review",
            "failed"
          ],
          "title": "Assessment Status",
          "type": "string"
        },
        "clarifications": {
          "items": {
            "$ref": "#/$defs/ClarificationRecord"
          },
          "title": "Clarifications",
          "type": "array"
        },
        "completion_photo_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Completion Photo Ids",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dashboard_status": {
          "enum": [
            "submitted",
            "in-progress",
            "resolved"
          ],
          "title": "Dashboard Status",
          "type": "string"
        },
        "display_status": {
          "title": "Display Status",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "illustrative": {
          "title": "Illustrative",
          "type": "boolean"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Job Id"
        },
        "latest_update": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportUpdate"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "photo_id": {
          "format": "uuid",
          "title": "Photo Id",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "routine"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "priority_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority Reason"
        },
        "public_reference": {
          "pattern": "^WG-[0-9A-F]{12}$",
          "title": "Public Reference",
          "type": "string"
        },
        "resident_answers": {
          "$ref": "#/$defs/ResidentAnswers"
        },
        "state": {
          "$ref": "#/$defs/ReportState"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/EventView"
          },
          "title": "Timeline",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "triage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriageRecommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "public_reference",
        "title",
        "address",
        "state",
        "display_status",
        "dashboard_status",
        "location",
        "note",
        "clarifications",
        "photo_id",
        "completion_photo_ids",
        "job_id",
        "version",
        "illustrative",
        "created_at",
        "updated_at",
        "latest_update",
        "timeline",
        "triage"
      ],
      "title": "OrganizerReportView",
      "type": "object"
    },
    "ProcessingTask": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "attempts",
        "error_code"
      ],
      "title": "ProcessingTask",
      "type": "object"
    },
    "ReportProcessing": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessingTask"
            },
            {
              "type": "null"
            }
          ]
        },
        "demo_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Demo Run Id"
        },
        "triage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessingTask"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assessment",
        "triage",
        "demo_run_id"
      ],
      "title": "ReportProcessing",
      "type": "object"
    },
    "ReportState": {
      "enum": [
        "received",
        "needs_info",
        "needs_review",
        "linked_to_job"
      ],
      "title": "ReportState",
      "type": "string"
    },
    "ReportUpdate": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "job_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobState"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "report_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportState"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "submitted",
                "in-progress",
                "resolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        }
      },
      "required": [
        "id",
        "kind",
        "created_at",
        "message",
        "status",
        "report_state",
        "job_status"
      ],
      "title": "ReportUpdate",
      "type": "object"
    },
    "ResidentAnswers": {
      "additionalProperties": false,
      "properties": {
        "fire": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fire"
        },
        "sharp_objects": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharp Objects"
        }
      },
      "title": "ResidentAnswers",
      "type": "object"
    },
    "TriageRecommendation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "decision_summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Decision Summary",
          "type": "string"
        },
        "duplicate_candidate_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Candidate Id"
        },
        "duplicate_confirmed": {
          "default": false,
          "title": "Duplicate Confirmed",
          "type": "boolean"
        },
        "estimated_service_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1440,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Service Minutes"
        },
        "evidence_report_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidence Report Ids",
          "type": "array"
        },
        "evidence_sufficient": {
          "default": false,
          "title": "Evidence Sufficient",
          "type": "boolean"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "hazard": {
          "default": false,
          "title": "Hazard",
          "type": "boolean"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Missing Information",
          "type": "array"
        },
        "next_action": {
          "enum": [
            "create_job",
            "link_job",
            "request_info",
            "review"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "proposed_equipment": {
          "items": {
            "$ref": "#/$defs/Equipment"
          },
          "title": "Proposed Equipment",
          "type": "array"
        },
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "expected_version",
        "report_id",
        "category",
        "proposed_equipment",
        "missing_information",
        "decision_summary",
        "evidence_report_ids",
        "next_action"
      ],
      "title": "TriageRecommendation",
      "type": "object"
    },
    "WasteAssessment": {
      "additionalProperties": false,
      "properties": {
        "comparison_reason": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Reason"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "forces_people_into_traffic": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Forces People Into Traffic",
          "type": "string"
        },
        "obstruction": {
          "enum": [
            "none_visible",
            "walkway",
            "road",
            "drain",
            "entrance",
            "unknown"
          ],
          "title": "Obstruction",
          "type": "string"
        },
        "obstruction_level": {
          "enum": [
            "none",
            "partial",
            "complete",
            "unknown"
          ],
          "title": "Obstruction Level",
          "type": "string"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "resident_context_agreement": {
          "default": "not_provided",
          "enum": [
            "consistent",
            "conflicting",
            "unclear",
            "not_provided"
          ],
          "title": "Resident Context Agreement",
          "type": "string"
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large",
            "unknown"
          ],
          "title": "Size",
          "type": "string"
        },
        "special_handling": {
          "enum": [
            "suspected",
            "none_identified",
            "unknown"
          ],
          "title": "Special Handling",
          "type": "string"
        },
        "visible_fire": {
          "default": "unknown",
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Visible Fire",
          "type": "string"
        },
        "visible_sharp_objects": {
          "default": "unknown",
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Visible Sharp Objects",
          "type": "string"
        }
      },
      "required": [
        "description",
        "size",
        "obstruction",
        "obstruction_level",
        "forces_people_into_traffic",
        "special_handling",
        "reason"
      ],
      "title": "WasteAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/AuditEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "processing": {
      "$ref": "#/$defs/ReportProcessing"
    },
    "report": {
      "$ref": "#/$defs/OrganizerReportView"
    }
  },
  "required": [
    "report",
    "events",
    "processing"
  ],
  "title": "OrganizerReportDetailsView",
  "type": "object"
}
