PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_POLL_INTERVAL_SECONDS=2
PHOTON_AGENT_SENDER_ID=
WASTEGRID_BACKEND_URL=
WASTEGRID_MESSAGING_API_KEY=
WASTEGRID_TIMEOUT_SECONDS=10
PHOTON_DELIVERY_DB_PATH=.data/photon-delivery.db

# Backend only. Copy into .env; never use privileged keys in Expo/React.
# Supabase Connect -> Session pooler (port 5432). URL-encode the DB password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server secret key (sb_secret_...) or legacy service_role key, never publishable/anon.
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY
SUPABASE_PHOTO_BUCKET=report-photos
# Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MESSAGING_API_KEY=REPLACE_WITH_RANDOM_BACKEND_TO_ADAPTER_SECRET
# JSON array of exact browser origins. Native Expo does not require CORS.
CORS_ORIGINS=["http://localhost:5173"]

# Optional external Person 3 integration; Chalk-only workers use the built-in deterministic decisions.
PERSON3_BASE_URL=
PERSON3_API_KEY=
# Alternative local factory returning a DecisionProvider: package.module:create_provider
INTEGRATION_FACTORY=
# Separate backend read-only context credential for Person 3's tool calls.
AGENT_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# New-report assessment through the existing Chalk Model Gateway.
CHALK_ROUTER_API_KEY=
CHALK_ENV_ID=
CHALK_MODEL=groq/qwen/qwen3.8-27b
CHALK_ROUTER_BASE_URL=https://api.chalk.ai/v1/router
# Optional for Grok 4.3: disable reasoning to reduce latency. Omit for other models.
# CHALK_REASONING_EFFORT=none
ASSESSMENT_TIMEOUT_SECONDS=30
# Nearby real reports are retained for review; 0 disables proximity review for demos.
DUPLICATE_RADIUS_METERS=10

# Opt-in organiser preview/dispatch routing. Set on BOTH API and worker.
ORGANIZER_ROUTING_ENABLED=false
# An OSRM-compatible server supporting driving Table requests for up to 30 locations.
# Required when enabled; no straight-line fallback. No API key needed for OSRM itself.
ROUTING_OSRM_BASE_URL=
ROUTING_PROVIDER_TIMEOUT_SECONDS=10
ROUTING_SERVICE_MINUTES=5
ROUTING_LOCATION_MAX_AGE_SECONDS=120
ROUTING_PREVIEW_MAX_AGE_SECONDS=120
ROUTING_MAX_DISPLACEMENT_METERS=100
ROUTING_IMPROVEMENT_BUDGET=10000
ROUTING_SOLVER_TIMEOUT_SECONDS=5
ROUTING_WAIT_WEIGHT=1
ROUTING_FINISH_WEIGHT=1
ROUTING_TRAVEL_WEIGHT=0.25
